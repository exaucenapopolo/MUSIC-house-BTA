{
  "name": "music-house-bta",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run tests/financial.test.ts tests/admin-config.test.ts tests/booking.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "set:role": "tsx scripts/set-role.ts",
    "test:rules": "firebase emulators:exec --project demo-music-house-bta --only firestore \"vitest run tests/firestore.rules.test.ts\"",
    "test:all": "npm test && npm run test:rules"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "firebase-admin": "^13.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8",
    "tsx": "^4.20.6",
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase-tools": "^14.22.0"
  },
  "engines": {
    "node": ">=22"
  }
}
